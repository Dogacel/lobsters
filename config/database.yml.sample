---
postgresql: &postgresql
  adapter: postgresql
  encoding: unicode 
  host: 127.0.0.1
  port: 15432
  pool: 5

sqlite3: &sqlite3
  adapter: sqlite3
  timeout: 5000

development:
  primary:
    <<: *postgresql
    database: lobsters_dev
    username: postgres
    password: localdev
  cache:
    <<: *sqlite3
    database: tmp/cache/cache.sqlite3
    migrations_paths: db/cache_migrate
  queue:
    <<: *sqlite3
    database: tmp/queue/queue.sqlite3
    migrations_paths: db/queue_migrate

test:
  <<: *postgresql
  database: lobsters_test
  username: postgres
  password: localdev

production:
  primary:
    <<: *postgresql
    database: lobsters
  cache:
    <<: *sqlite3
    database: /srv/lobste.rs/cache/cache.sqlite3
    migrations_paths: db/cache_migrate
  queue:
    <<: *sqlite3
    database: /srv/lobste.rs/queue/queue.sqlite3
    migrations_paths: db/queue_migrate
